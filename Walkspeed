-- Presets Frame
local PresetsFrame = Instance.new("Frame")
PresetsFrame.Name = "PresetsFrame"
PresetsFrame.Size = UDim2.new(1, -20, 0, 60)
PresetsFrame.Position = UDim2.new(0, 10, 0, 190)
PresetsFrame.BackgroundTransparency = 1
PresetsFrame.Parent = MainFrame

-- Preset Buttons
local presets = {
    {name = "Walk", value = 16},
    {name = "Jog", value = 50},
    {name = "Run", value = 100},
    {name = "Sprint", value = 200},
    {name = "MAX", value = 300}
}

for i, preset in ipairs(presets) do
    local button = Instance.new("TextButton")
    button.Name = preset.name .. "Button"
    button.Size = UDim2.new(0.18, 0, 0, 25)
    button.Position = UDim2.new(0.01 + (i - 1) * 0.20, 0, 0, 0)
    button.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
    button.Text = preset.name
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.TextSize = 11
    button.Font = Enum.Font.GothamBold
    button.Parent = PresetsFrame
    
    button.MouseButton1Click:Connect(function()
        setSpeed(preset.value)
    end)
end

-- Resize MainFrame to fit presets
MainFrame.Size = UDim2.new(0, 250, 0, 260)

-- Speed Setting Function
function setSpeed(speed)
    speed = math.clamp(speed, 16, 300)
    humanoid.WalkSpeed = speed
    SpeedDisplay.Text = "Current Speed: " .. speed
    
    -- Update slider position
    local percent = (speed - 16) / (300 - 16)
    local sliderWidth = SliderFrame.AbsoluteSize.X
    SliderButton.Position = UDim2.new(0, percent * sliderWidth - 8, 0.5, -8)
    SliderFill.Size = UDim2.new(0, percent * sliderWidth, 1, 0)
end

-- Slider Dragging
local dragging = false

SliderButton.MouseButton1Down:Connect(function()
    dragging = true
end)

game:GetService("UserInputService").InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local sliderPos = SliderFrame.AbsolutePosition
        local sliderWidth = SliderFrame.AbsoluteSize.X
        local mouseX = input.Position.X - sliderPos.X
        local percent = math.clamp(mouseX / sliderWidth, 0, 1)
        
        local speed = math.floor(16 + percent * (300 - 16))
        setSpeed(speed)
    end
end)

-- Apply Button Function
ApplyButton.MouseButton1Click:Connect(function()
    local value = tonumber(SpeedInput.Text)
    if value then
        setSpeed(value)
    else
        SpeedInput.Text = "Invalid input!"
        task.wait(1)
        SpeedInput.Text = ""
    end
end)

-- Close Button Function
CloseButton.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- Character Respawn Handler
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = character:WaitForChild("Humanoid")
    
    -- Preserve walkspeed on respawn
    local currentSpeed = humanoid.WalkSpeed
    if currentSpeed < 16 then
        currentSpeed = 16
    end
    setSpeed(currentSpeed)
end)

-- Initial Setup
setSpeed(16)

-- Toggle GUI with F key
game:GetService("UserInputService").InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.F then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

print("⚡ Walkspeed script loaded! Press F to toggle GUI")
